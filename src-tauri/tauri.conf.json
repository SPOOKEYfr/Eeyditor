{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eeyditor",
  "version": "0.1.0",
  "identifier": "os.eeyditor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eeyditor",
        "width": 1600,
        "height": 950,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#121318",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Eeyditor",
    "longDescription": "Eeyditor is a fast, precise desktop video editor.",
    "license": "GPL-3.0-only"
  }
}
